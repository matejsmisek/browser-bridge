<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>browser-bridge-hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>@REPO@/bridge/hub.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- The Tailscale address may not exist yet at login; keep retrying. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
